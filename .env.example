# Copy names into the shell or a secret store. Do not commit a filled .env.
# The default planner is the local stub. It needs no key and spends nothing.
# CI uses this default. It does not set LIVE_MODE or a model key.

LLM_PROVIDER=fake

# `python -m agent_commerce.evalkit live` does not send, even if the lines
# below are set. Do not set them in CI.
# LIVE_MODE=1
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT_S=30

# `make eval-live` sends only when LIVE_ENABLED is exactly 1.
# The key is XAI_API_KEY. Do not write it into a file, a log, or a report.
# Default base URL is https://api.x.ai/v1
# Default model is grok-4.20-0309-non-reasoning
# The process stops before the next request when MAX_LIVE_SPEND_USD is reached.
# Cost comes from usage.cost_in_usd_ticks when the response has it.
# Otherwise set the three price lines together, or the next request is blocked.
# LIVE_ENABLED=1
# XAI_API_KEY=
# XAI_BASE_URL=
# XAI_MODEL=
# XAI_TIMEOUT_S=60
# MAX_LIVE_SPEND_USD=
# LIVE_HTTP_ATTEMPTS=2
# LIVE_LOG_PATH=var/live/calls.jsonl
# LIVE_INPUT_USD_PER_MILLION=
# LIVE_OUTPUT_USD_PER_MILLION=
# LIVE_PRICE_DATE=
# LIVE_RUN_LABEL=live

# Local files. A real deployment would not use this SQLite file as the ledger
# of record. See docs/adr/0007-local-stub-merchant.md.
DATABASE_PATH=var/runtime.sqlite
TRACE_DIR=var/traces
EVALS_DIR=evals

# Empty means each run creates a temporary directory and deletes it.
# A set value must be a directory this process can write. The key file is
# labelled NOT REAL. Do not point this at a home directory in docs or CI.
LAB_KEY_DIR=

# Payment retries. The delay function caps at 8 seconds. The eval harness
# passes a sleeper that records the delay and does not sleep.
MAX_PAYMENT_ATTEMPTS=3
MAX_AGENT_STEPS=12

# Every invariant must pass. This is not an LLM judge.
EVAL_CHECK_THRESHOLD=1.0

LOG_LEVEL=INFO

# The stub merchant binds loopback only.
MERCHANT_HOST=127.0.0.1
MERCHANT_PORT=8765

# Optional hygiene list for local runs of the README test. One term per line.
# Unset by default. Do not commit the file. banned-terms.txt is gitignored.
# BANNED_TERMS_FILE=
